## višak riječi, razmaka i pravopisnih znakova...

# [ ]{2,3} ->                       # Unijeli ste dvije ili tri bjeline. Možda biste htjeli samo jednu?
(\w+)(\.\.)(?!\.) -> \1...|\1.      # Unijeli ste svega dvije točke, treba ili jednu ili tri.
(\w+)(\?\?)(?!\?) -> \1???| \1?     # Unijeli ste dva upitnika, treba ili jednu ili tri.
(\w+)(\!\!)(?!\!) -> \1!!!| \1!     # Unijeli ste dva upitnika, treba ili jednu ili tri.



##  zamjena 's' i 'sa'

\bs\s([kKpP]?[szšžSZŠŽ]\w+)\b -> sa \1        # Kada riječ iza prijed. 's' počinje sa 's, z, š, ž, ks, ps', treba pisati 'sa'.
\bsa\s((?![kKpP])[^szšžSZŠŽ][a-z])\b -> s \1  # Kada riječ iza prijed. 'sa' ne počinje sa 's, z, š, ž', treba pisati 's'.
\bsa\s(([kKpP])[^szšžSZŠŽ]\w+)\b -> s \1      # Kada riječ iza prijed. 'sa' ne počinje sa 'ks, ps', treba pisati 's'.
\bsa\s(SAD-om) -> s SAD-om                    # Trebalo bi pisati 's SAD-om' jer se čita [es-a-de].


## Veliko i malo slovo



## Točka iza razmaka na kraju rečenice

(\w+)\s+\1 -> \1   # Unijeli ste dvaput istu riječ.
(\w+)\s([\.\,\?\!\:\;])(?![\w\w+]) -> \1\2     # Slučajno ste unijeli bjelinu između posljednje riječi u rečenici i točke.
(\w+)\s([\.\,\?\!\:\;])(?!\s)(\w+) -> \1\2 \3  # Nista unijeli razmak između kraja prethodne i početka nove rečenice.


## Razmak između kratica

n.e. -> n. e.   # Kratica 'nove ere' piše se s razmakom.



# Ispravljanje izraza u bolje

iznimno često -> vrlo često         # Unijeli ste oksimoron, možda ste mislili:
s obzirom da -> s obzirom na to da  # Ispravite pogrešno:


# Brojevi sa spojnicom
\b(\d[0])\-tih\b -> \1-ih   # Možda ste željeli napisati:


# Sastavljeno i nesastavljeno pisanje

za ništa -> ni za što | nizašto                                                                 # (1) Ne bih to učinio ni za što. (2) Radio je nizašto.
p[hH] vrijednost -> pH-vrijednost                                                               # Pokrate se uz glavnu riječ pišu sa spojnicom.
([pP]lacebo) (učin\w|efek\w+|pilul\w+) -> \1-\2                                                 # Riječ '\' piše se sa spojnicom s riječju '\2'.
([pP]op) (kultu\w+) -> \1-\2                                                                    # Riječ '\1' piše se sa spojnicom s riječju '\2'.
# \b{prefiksoidi} ((?!sam|si|je|smo|ste|su|ću|ćeš|će|ćemo|ćete)\w+)\b -> \1\2                   # Prefiksoid '\1' se piše sastavljeno s '\2'.
\b{prefiksoidi}\s+(?!(?:{enklitike})\b)(\w+)\b -> \1\2                                          # Prefiksoid '\1' se piše sastavljeno s '\2'.

